rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == 'psHLxoIeGfRNqQSwTbPUVxFCU8H2' && uid == request.auth.uid; }
  match /users/{uid} {
   allow read: if owner(uid);
   match /patients/{id} { allow read: if owner(uid); allow create,update: if owner(uid) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120; allow delete: if false; }
   match /sessions/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid) && request.resource.data.patientId is string && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 1000000;
    allow update: if owner(uid) && (!exists(/databases/$(database)/documents/users/$(uid)/billingClaims/$(id)) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasRecord','recordId','googleEventId','googleCalendarUrl','meetLink','notes']));
    allow delete: if false;
   }
   match /records/{id} { allow read,create,update: if owner(uid); allow delete: if false; }
   match /anamnesis/{id} { allow read,create,update: if owner(uid); allow delete: if false; }
   match /assessments/{id} { allow read,create: if owner(uid); allow update,delete: if false; }
   match /payments/{id} { allow read: if owner(uid); allow create,update: if owner(uid) && !exists(/databases/$(database)/documents/users/$(uid)/legacyCoverage/$(id)); allow delete: if false; }
   match /settings/{id} { allow read,create,update: if owner(uid); allow delete: if false; }
   match /audit_logs/{id} { allow read,create: if owner(uid); allow update,delete: if false; }
   match /billingPolicies/{id} { allow read: if owner(uid); allow write: if false; }
   match /charges/{id} { allow read: if owner(uid); allow write: if false; }
   match /legacyCoverage/{id} { allow read: if owner(uid); allow write: if false; }
   match /billingPeriods/{id} { allow read: if owner(uid); allow write: if false; }
   match /billingAlerts/{id} { allow read: if owner(uid); allow write: if false; }
   match /billingClaims/{id} { allow read: if owner(uid); allow write: if false; }
   match /asaasCustomers/{id} { allow read: if owner(uid); allow write: if false; }
  }
  match /public_intakes/{id} { allow read,update,delete: if request.auth != null && request.auth.uid == 'psHLxoIeGfRNqQSwTbPUVxFCU8H2'; allow create: if false; }
  match /blog_posts/{id} {
    allow read: if resource.data.status == 'published' || (request.auth != null && request.auth.uid == 'psHLxoIeGfRNqQSwTbPUVxFCU8H2');
    allow create, update, delete: if request.auth != null && request.auth.uid == 'psHLxoIeGfRNqQSwTbPUVxFCU8H2';
  }
  // Preserve authenticated access to known legacy root collections during migration.
  match /{name}/{id} {
    allow read: if request.auth != null && request.auth.uid == 'psHLxoIeGfRNqQSwTbPUVxFCU8H2' && name in ['patients','anamnesis','clinical_records','sessions','assessments','payments','settings','audit_logs','dashboard_metrics'];
  }
 }
}
